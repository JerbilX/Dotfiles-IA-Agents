#!/usr/bin/env python3
"""
CLI determinista git-prune-gone para poda segura y atómica de ramas locales huérfanas ([gone]).
Cumple con los estándares de Nivel 1 (tooling), confinamiento de sandbox y prefix matching.
Ref: docs/adr/0032-compatibilidad-de-poda-y-rollback-con-squash-merge.md
Ref: docs/adr/0033-optimizacion-de-turnos-e2e-git-prune-gone-sync.md
"""

import argparse
import json
import os
import subprocess
import sys
from typing import Any, Dict, List, Optional, Tuple


def is_git_repository() -> bool:
    try:
        proc = subprocess.run(
            ["git", "rev-parse", "--is-inside-work-tree"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        return proc.returncode == 0
    except FileNotFoundError:
        sys.stderr.write("Error: El comando 'git' no está instalado o no se encuentra en $PATH.\n")
        sys.exit(1)


def resolve_base_branch(custom_base: Optional[str] = None) -> str:
    """
    Resuelve la rama base contra la cual verificar la integración.
    Prioridad: argumento CLI -> .repo-config.json -> 'main'.
    """
    if custom_base:
        return custom_base.strip()

    cfg_name = ".repo-config.json"
    if os.path.isfile(cfg_name):
        try:
            with open(cfg_name, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict) and "base_branch" in data and isinstance(data["base_branch"], str):
                    val = data["base_branch"].strip()
                    if val:
                        return val
        except Exception:
            pass

    return "main"


def verify_branch_exists(branch_name: str) -> bool:
    """
    Verifica si una referencia o rama existe en el repositorio local o remoto.
    """
    proc = subprocess.run(
        ["git", "rev-parse", "--verify", f"{branch_name}^{{commit}}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if proc.returncode == 0:
        return True

    # Fallback a referencia remota si aplica
    proc_remote = subprocess.run(
        ["git", "rev-parse", "--verify", f"origin/{branch_name}^{{commit}}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    return proc_remote.returncode == 0


def get_current_branch() -> Optional[str]:
    """
    Retorna el nombre de la rama actualmente activa, o None si está en detached HEAD.
    """
    proc = subprocess.run(
        ["git", "branch", "--show-current"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if proc.returncode == 0:
        val = proc.stdout.strip()
        return val if val else None
    return None


def check_worktree_clean() -> Tuple[bool, str]:
    """
    Verifica que el árbol de trabajo no contenga cambios pendientes rastreados (staged o unstaged).
    Los archivos no rastreados (untracked) se ignoran intencionalmente.
    """
    proc = subprocess.run(
        ["git", "status", "--porcelain", "--untracked-files=no"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        err = proc.stderr.strip() or "Error al inspeccionar estado del árbol de trabajo."
        return False, err
    lines = [line.strip() for line in proc.stdout.splitlines() if line.strip()]
    if lines:
        return False, f"El árbol de trabajo contiene {len(lines)} cambio(s) pendiente(s) sin commitear."
    return True, ""


def sync_base_branch(base: str) -> Tuple[bool, str, Dict[str, Any]]:
    """
    Conmuta a la rama base (si no está seleccionada) y ejecuta git pull --prune --ff-only.
    Retorna (éxito, mensaje_error, metadata_sync).
    """
    curr = get_current_branch()
    checkout_performed = False

    if curr != base:
        proc_co = subprocess.run(
            ["git", "checkout", base],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        if proc_co.returncode != 0:
            err = proc_co.stderr.strip() or proc_co.stdout.strip() or "Error al ejecutar git checkout"
            return False, f"Fallo al cambiar a la rama base '{base}': {err}", {
                "status": "checkout_failed",
                "base_branch": base,
                "current_branch": curr,
                "checkout_performed": False,
                "error": err,
            }
        checkout_performed = True

    proc_pull = subprocess.run(
        ["git", "pull", "--prune", "--ff-only"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if proc_pull.returncode != 0:
        err = proc_pull.stderr.strip() or proc_pull.stdout.strip() or "Error al ejecutar git pull --prune --ff-only"
        return False, f"Fallo al sincronizar '{base}' en fast-forward: {err}", {
            "status": "pull_failed",
            "base_branch": base,
            "checkout_performed": checkout_performed,
            "error": err,
        }

    return True, "", {
        "status": "synced",
        "base_branch": base,
        "checkout_performed": checkout_performed,
        "pull_output": proc_pull.stdout.strip(),
    }


def get_branches_info() -> List[Tuple[str, str, str]]:
    """
    Retorna una lista de tuplas (head_indicator, branch_name, upstream_track)
    para cada rama local.
    """
    cmd = ["git", "branch", "--format=%(HEAD)|%(refname:short)|%(upstream:track)"]
    proc = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        err_msg = proc.stderr.strip() or "Fallo al inspeccionar ramas locales."
        sys.stderr.write(f"Error: {err_msg}\n")
        sys.exit(proc.returncode)

    branches = []
    for line in proc.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        parts = line.split("|")
        if len(parts) >= 3:
            head_ind = parts[0].strip()
            branch = parts[1].strip()
            track = parts[2].strip()
            branches.append((head_ind, branch, track))
    return branches


def classify_branch(base: str, branch: str) -> str:
    """
    Clasifica una rama respecto a la rama base en:
    - 'merged': Rama integrada mediante merge commit tradicional (ancestro directo).
    - 'squash-merged': Rama integrada mediante squash merge (árbol equivalente).
    - 'unmerged': Rama con cambios no integrados o con conflictos respecto a base.
    """
    # 1. Comprobación de ascendencia directa (tradicional)
    proc_anc = subprocess.run(
        ["git", "merge-base", "--is-ancestor", branch, base],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if proc_anc.returncode == 0:
        return "merged"

    # 2. Comprobación de equivalencia de árbol en memoria (squash merge)
    proc_base_tree = subprocess.run(
        ["git", "rev-parse", f"{base}^{{tree}}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if proc_base_tree.returncode != 0:
        return "unmerged"
    base_tree = proc_base_tree.stdout.strip()

    proc_tree = subprocess.run(
        ["git", "merge-tree", "--write-tree", base, branch],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if proc_tree.returncode == 0 and proc_tree.stdout.strip() == base_tree:
        return "squash-merged"

    return "unmerged"


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="git-prune-gone",
        description="Poda segura y atómica de ramas locales cuyo tracking remoto fue eliminado ([gone]).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Inspecciona y clasifica ramas zombi sin eliminarlas.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Genera salida estructurada en formato JSON.",
    )
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="Fuerza la eliminación con git branch -D de todas las ramas [gone], incluidas las no integradas.",
    )
    parser.add_argument(
        "--base",
        metavar="RAMA",
        help="Rama base contra la cual verificar la integración (default: detectada de .repo-config.json o 'main').",
    )
    parser.add_argument(
        "--sync",
        action="store_true",
        help="Sincroniza la rama base (checkout si es necesario, pull --prune --ff-only) antes de podar.",
    )

    args = parser.parse_args()

    if not is_git_repository():
        msg = "Error: El directorio actual no pertenece a un repositorio Git."
        if args.json:
            print(json.dumps({"error": msg}))
        else:
            sys.stderr.write(f"{msg}\n")
        return 1

    base_branch = resolve_base_branch(args.base)
    if not verify_branch_exists(base_branch):
        msg = f"Error: La rama base '{base_branch}' no existe en el repositorio."
        if args.json:
            print(json.dumps({"error": msg}))
        else:
            sys.stderr.write(f"{msg}\n")
        return 1

    sync_meta: Optional[Dict[str, Any]] = None
    if args.sync:
        clean, err_clean = check_worktree_clean()
        if not clean:
            if args.json:
                print(json.dumps({
                    "status": "dirty_worktree",
                    "error": err_clean,
                    "base_branch": base_branch,
                }, indent=2, ensure_ascii=False))
            else:
                sys.stderr.write(f"Error: {err_clean}\n")
            return 1

        ok, err_sync, sync_meta = sync_base_branch(base_branch)
        if not ok:
            if args.json:
                print(json.dumps({
                    "status": sync_meta.get("status", "sync_failed"),
                    "error": err_sync,
                    "base_branch": base_branch,
                    "sync": sync_meta,
                }, indent=2, ensure_ascii=False))
            else:
                sys.stderr.write(f"Error: {err_sync}\n")
            return 1

    branches = get_branches_info()
    candidates: List[str] = []
    skipped_current: List[str] = []

    for head_ind, branch, track in branches:
        if track == "[gone]":
            if head_ind == "*":
                skipped_current.append(branch)
            else:
                candidates.append(branch)

    # Caso: árbol limpio
    if not candidates and not skipped_current:
        clean_res: Dict[str, Any] = {
            "status": "clean",
            "base_branch": base_branch,
            "candidates": [],
            "pruned": [],
            "unmerged": [],
            "failed": [],
            "skipped_current": [],
            "message": "Árbol de ramas locales limpio: no hay ramas con upstream zombi ([gone]).",
        }
        if sync_meta:
            clean_res["sync"] = sync_meta
        if args.json:
            print(json.dumps(clean_res, indent=2, ensure_ascii=False))
        else:
            if args.sync:
                print(f"Sincronización exitosa con 'origin' en rama base '{base_branch}'.")
            print("Árbol de ramas locales limpio: no hay ramas con upstream zombi ([gone]).")
        return 0

    # Clasificación de candidatos
    classified_candidates: List[Dict[str, str]] = []
    for c in candidates:
        cls = classify_branch(base_branch, c)
        classified_candidates.append({"branch": c, "classification": cls})

    # Caso: dry-run
    if args.dry_run:
        dry_res: Dict[str, Any] = {
            "status": "dry_run",
            "base_branch": base_branch,
            "candidates": classified_candidates,
            "skipped_current": skipped_current,
        }
        if sync_meta:
            dry_res["sync"] = sync_meta
        if args.json:
            print(json.dumps(dry_res, indent=2, ensure_ascii=False))
        else:
            if args.sync:
                print(f"Sincronización exitosa con 'origin' en rama base '{base_branch}'.")
            if classified_candidates:
                print(f"Ramas candidatas a poda ([gone]) contra base '{base_branch}':")
                for item in classified_candidates:
                    b = item["branch"]
                    c = item["classification"]
                    if c == "merged":
                        print(f"  - {b} [merged] (será podada de forma segura con git branch -d)")
                    elif c == "squash-merged":
                        print(f"  - {b} [squash-merged] (integrada en {base_branch} - será podada con git branch -D)")
                    else:
                        print(f"  - {b} [unmerged] (no integrada - omitida a menos que use --force)")
            if skipped_current:
                print(f"\n[!] Advertencia: La(s) siguiente(s) rama(s) activa(s) tiene(n) upstream [gone] pero no pueden eliminarse mientras estén seleccionadas:")
                for sc in skipped_current:
                    print(f"  - {sc} (rama actual - cambie a {base_branch} antes de podar)")
        return 0

    # Ejecución de poda
    pruned: List[Dict[str, str]] = []
    unmerged: List[Dict[str, str]] = []
    failed: List[Dict[str, str]] = []

    for item in classified_candidates:
        b = item["branch"]
        cls = item["classification"]

        if cls == "merged":
            # Rama con merge tradicional: poda segura con -d
            res = subprocess.run(
                ["git", "branch", "-d", b],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=False,
            )
            if res.returncode == 0:
                pruned.append({"branch": b, "classification": cls})
            else:
                err = res.stderr.strip() or res.stdout.strip() or "Error al podar rama merged"
                failed.append({"branch": b, "classification": cls, "error": err})

        elif cls == "squash-merged":
            # Rama verificada como integrada vía squash: poda segura con -D
            res = subprocess.run(
                ["git", "branch", "-D", b],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=False,
            )
            if res.returncode == 0:
                pruned.append({"branch": b, "classification": cls})
            else:
                err = res.stderr.strip() or res.stdout.strip() or "Error al podar rama squash-merged"
                failed.append({"branch": b, "classification": cls, "error": err})

        else:  # unmerged
            if args.force:
                res = subprocess.run(
                    ["git", "branch", "-D", b],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    check=False,
                )
                if res.returncode == 0:
                    pruned.append({"branch": b, "classification": "unmerged (forced)"})
                else:
                    err = res.stderr.strip() or res.stdout.strip() or "Error al forzar eliminación"
                    failed.append({"branch": b, "classification": cls, "error": err})
            else:
                msg = f"Rama no integrada en '{base_branch}'. Requiere -f / --force para eliminar."
                unmerged.append({"branch": b, "classification": cls, "error": msg})
                failed.append({"branch": b, "classification": cls, "error": msg})

    if args.json:
        status = "success" if not failed else ("partial_failure" if pruned else "failed")
        result = {
            "status": status,
            "base_branch": base_branch,
            "pruned": pruned,
            "unmerged": unmerged,
            "failed": failed,
            "skipped_current": skipped_current,
        }
        if sync_meta:
            result["sync"] = sync_meta
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        if args.sync:
            print(f"Sincronización exitosa con 'origin' en rama base '{base_branch}'.")
        if pruned:
            print(f"Ramas podadas exitosamente contra base '{base_branch}':")
            for p in pruned:
                print(f"  - {p['branch']} (eliminada: {p['classification']})")
        if unmerged:
            print(f"\nRamas no integradas omitidas ([gone]):")
            for u in unmerged:
                print(f"  - {u['branch']} [{u['classification']}]: {u['error']}")
        if skipped_current:
            print(f"\n[!] Advertencia: La rama actual tiene upstream [gone] y no fue eliminada:")
            for sc in skipped_current:
                print(f"  - {sc} (activa - cambie a {base_branch} antes de podar)")
        other_failed = [f for f in failed if f not in unmerged]
        if other_failed:
            print("\nError al podar las siguientes ramas:")
            for f in other_failed:
                print(f"  - {f['branch']}: {f['error']}")

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
