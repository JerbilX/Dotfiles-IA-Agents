#!/usr/bin/env python3
"""
agent-circuit-breaker - Lifecycle Hook PreToolUse para Antigravity y Claude Code.
Interrumpe deterministamente bucles de lectura pasiva consecutiva (> 6, ADR-0046)
y bucles cíclicos alternantes (ping-pong, profundidad 4-6) e impone un
disyuntor de seguridad mecánico para evitar parálisis por inspección.
En Claude Code además exige lectura paginada y clasifica los comandos Bash de
mera inspección como lecturas pasivas (ADR-0051).
"""

import json
import os
import re
import shlex
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional, Union

PASSIVE_TOOLS = {
    "view_file",
    "grep_search",
    "find_by_name",
    "list_dir",
    "read_url_content",
    "read_browser_page",
    # Claude Code (ADR-0051). "Bash(read)" es un Bash clasificado como inspección pasiva.
    "Read",
    "Grep",
    "Glob",
    "LS",
    "WebFetch",
    "WebSearch",
    "Bash(read)",
}

ACTIVE_TOOLS = {
    "replace_file_content",
    "write_to_file",
    "run_command",
    "bash",
    "execute_command",
    "generate_image",
    "ask_question",
    # Claude Code (ADR-0051)
    "Bash",
    "Edit",
    "MultiEdit",
    "Write",
    "NotebookEdit",
    "AskUserQuestion",
}

# ADR-0046: 6 deja pasar el 89% de las rachas naturales de exploración y corta la cola de parálisis (10+).
DEFAULT_MAX_PASSIVE_READS = 6


def extract_file_target(args: Dict[str, Any]) -> str:
    """Extrae la ruta del archivo objetivo desde los argumentos si está disponible."""
    if not isinstance(args, dict):
        return ""
    for k in ("AbsolutePath", "TargetFile", "file_path", "filePath", "path", "filename", "file"):
        if k in args and args[k]:
            return str(args[k]).strip('\'"')
    for k, v in args.items():
        if k.lower().replace("_", "") in ("absolutepath", "targetfile", "filepath", "path", "file"):
            if v:
                return str(v).strip('\'"')
    return ""


def get_tool_signature(tool_name: str, args: Dict[str, Any]) -> str:
    """Genera la firma canónica de la invocación de herramienta."""
    target = extract_file_target(args)
    target_base = Path(target).name if target else ""
    return f"{tool_name}:{target_base}" if target_base else tool_name


def detect_ping_pong_loop(events: List[str]) -> Optional[str]:
    """
    Detecta si una secuencia de eventos de herramientas recientes presenta
    un patrón cíclico alternante (ping-pong) con profundidad de 4 a 6 eventos.
    Retorna la representación del patrón (ej. 'A <-> B' o 'A -> B -> C') o None.
    """
    if len(events) < 4:
        return None

    # 1. Comprobar alternancia de 2 estados en los últimos 4 eventos (profundidad 4-6)
    # ej: A, B, A, B o sufijo de A, B, A, B, A / A, B, A, B, A, B
    w4 = events[-4:]
    if w4[0] != w4[1] and w4[0] == w4[2] and w4[1] == w4[3]:
        return f"{w4[0]} <-> {w4[1]}"

    # 2. Comprobar alternancia de 3 estados en los últimos 6 eventos (profundidad 6)
    # ej: A, B, C, A, B, C
    if len(events) >= 6:
        w6 = events[-6:]
        if (
            w6[0] == w6[3]
            and w6[1] == w6[4]
            and w6[2] == w6[5]
            and len({w6[0], w6[1], w6[2]}) == 3
        ):
            return f"{w6[0]} -> {w6[1]} -> {w6[2]}"

    return None


def read_tail_json_lines(transcript_path: Path, max_bytes: int) -> List[Dict[str, Any]]:
    """Parsea los registros JSONL contenidos en los últimos `max_bytes` del transcript."""
    with open(transcript_path, "rb") as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        read_size = min(size, max_bytes)
        f.seek(size - read_size)
        chunk = f.read().decode("utf-8", errors="ignore")

    records = []
    for line in chunk.strip().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except Exception:
            continue
        if isinstance(rec, dict):
            records.append(rec)
    return records


def read_recent_transcript_records(transcript_path: Path) -> List[Dict[str, Any]]:
    """Lee y parsea los registros recientes del transcript delimitados por la última intervención del usuario."""
    if not transcript_path.is_file():
        return []

    try:
        records = read_tail_json_lines(transcript_path, 65536)

        # Encontrar la última intervención del usuario
        last_user_idx = -1
        for idx, rec in enumerate(records):
            source = rec.get("source")
            rec_type = rec.get("type")
            if source in ("USER", "USER_EXPLICIT") or rec_type == "USER_INPUT":
                last_user_idx = idx

        return records[last_user_idx + 1:] if last_user_idx != -1 else records
    except Exception:
        return []


def extract_recent_tool_events(records: List[Dict[str, Any]]) -> List[str]:
    """Extrae las firmas de las herramientas invocadas cronológicamente."""
    events = []
    for rec in records:
        tcs = rec.get("tool_calls", [])
        if not isinstance(tcs, list):
            continue
        for tc in tcs:
            if not isinstance(tc, dict):
                continue
            tc_name = tc.get("name", "")
            if not tc_name:
                continue
            tc_args = tc.get("args", {})
            sig = tc.get("sig") or get_tool_signature(tc_name, tc_args if isinstance(tc_args, dict) else {})
            events.append(sig)
    return events


def inspect_transcript_for_passive_reads(
    transcript_or_records: Union[Path, List[Dict[str, Any]]],
    max_reads: int = DEFAULT_MAX_PASSIVE_READS
) -> int:
    """Calcula la cantidad de llamadas pasivas consecutivas recientes en la transcripción."""
    if isinstance(transcript_or_records, (str, Path)):
        records = read_recent_transcript_records(Path(transcript_or_records))
    else:
        records = transcript_or_records

    consecutive_passive_count = 0
    for rec in reversed(records):
        source = rec.get("source")
        rec_type = rec.get("type")

        # La intervención del usuario reinicia la cuenta
        if source in ("USER", "USER_EXPLICIT") or rec_type == "USER_INPUT":
            break

        tcs = rec.get("tool_calls", [])
        if not tcs:
            continue

        has_active = any(tc.get("name") in ACTIVE_TOOLS for tc in tcs)
        if has_active:
            break

        has_passive = any(tc.get("name") in PASSIVE_TOOLS for tc in tcs)
        if has_passive:
            consecutive_passive_count += 1
        else:
            break

    return consecutive_passive_count


def evaluate_pre_tool_use(payload: dict) -> dict:
    """Evalúa el payload de PreToolUse y retorna la decisión canónica."""
    tool_call = payload.get("toolCall", {})
    tool_name = tool_call.get("name", "")
    tool_args = tool_call.get("args", {})

    transcript_path_str = payload.get("transcriptPath")
    if not transcript_path_str:
        return {"decision": "allow"}

    tpath = Path(transcript_path_str)
    if not tpath.is_file():
        return {"decision": "allow"}

    recent_records = read_recent_transcript_records(tpath)
    candidate_sig = get_tool_signature(tool_name, tool_args if isinstance(tool_args, dict) else {})
    return evaluate_loops(tool_name, candidate_sig, recent_records)


def evaluate_loops(tool_name: str, candidate_sig: str, recent_records: List[Dict[str, Any]]) -> dict:
    """Aplica la detección de ping-pong y el umbral de lecturas pasivas sobre registros normalizados."""
    # 1. Detección de bucle cíclico alternante (Ping-Pong)
    transcript_events = extract_recent_tool_events(recent_records)
    combined_events = transcript_events + [candidate_sig]

    ping_pong_pattern = detect_ping_pong_loop(combined_events)
    if not ping_pong_pattern and len(transcript_events) >= 4:
        ping_pong_pattern = detect_ping_pong_loop(transcript_events)

    if ping_pong_pattern:
        reason = (
            f"Hard Circuit Breaker Activado: Se detectó un bucle cíclico alternante ping-pong "
            f"('{ping_pong_pattern}') en las herramientas recientes. "
            f"Prohibido continuar en oscilación cíclica. Detén las herramientas repetitivas "
            f"(Stop & Synthesize) y declara formalmente tu hipótesis técnica antes de continuar."
        )
        return {
            "decision": "deny",
            "reason": reason,
        }

    # 2. Si no es una herramienta pasiva de inspección, permitir sin costo
    if tool_name not in PASSIVE_TOOLS:
        return {"decision": "allow"}

    # 3. Límite de lecturas pasivas consecutivas
    max_reads = int(os.environ.get("AGENT_CIRCUIT_BREAKER_MAX_READS", str(DEFAULT_MAX_PASSIVE_READS)))
    consecutive_reads = inspect_transcript_for_passive_reads(recent_records, max_reads)

    # Si ya se alcanzó o superó el umbral, la llamada actual excede el límite permitido
    if consecutive_reads >= max_reads:
        reason = (
            f"Hard Circuit Breaker Activado: Has alcanzado el límite de {max_reads} lecturas pasivas "
            f"consecutivas ('{tool_name}') sin acción intermedia observable. "
            f"Detente y sintetiza: resume hallazgos, hipótesis y plan, y consulta al usuario "
            f"(Stop & Ask) si falta información. Edita o ejecuta pruebas solo si ya tienes "
            f"evidencia suficiente para un cambio acotado. Prohibido usar ediciones provisorias "
            f"o comandos irrelevantes para reiniciar el contador."
        )
        return {
            "decision": "deny",
            "reason": reason,
        }

    return {"decision": "allow"}


# --- Claude Code (#287, ADR-0051) ---

# Los registros de Claude incluyen tool_results voluminosos: ventana mayor que en Antigravity.
CLAUDE_TAIL_BYTES = 1024 * 1024
READ_MAX_WINDOW = 200
READ_UNPAGED_MAX_LINES = 150
NON_TEXT_SUFFIXES = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".pdf", ".ipynb"}

# Lista conservadora: un comando no listado cuenta como acción activa (no bloquea, reinicia el contador).
PASSIVE_SHELL_COMMANDS = {
    "cat", "head", "tail", "wc", "ls", "tree", "grep", "rg", "find", "sed", "awk",
    "jq", "cut", "sort", "uniq", "file", "stat", "readlink", "realpath", "pwd",
    "echo", "printf", "cd", "diff", "basename", "dirname", "true",
}
PASSIVE_GIT_SUBCOMMANDS = {"status", "log", "show", "diff", "blame", "ls-files", "rev-parse", "grep"}
PASSIVE_GH_ACTIONS = {"view", "list", "diff", "checks", "status"}
# Prefijos que se descartan para evaluar el comando que sigue.
SHELL_PREFIX_KEYWORDS = {"do", "then", "else", "if", "while", "until", "!", "{", "(", "time"}
# Segmentos de control que no ejecutan un comando propio.
SHELL_CONTROL_SEGMENTS = {"for", "done", "fi", "}", ")"}
_SAFE_REDIRECTS = re.compile(r"&>\s*/dev/null|\d*>\s*/dev/null|\d*>&\d+")
_SHELL_SEGMENT_SPLIT = re.compile(r"\|\||&&|[|;\n]")


def _is_passive_shell_tokens(tokens: List[str]) -> bool:
    cmd = os.path.basename(tokens[0])
    args = tokens[1:]
    if cmd == "git":
        i = 0
        while i < len(args) and args[i].startswith("-"):
            i += 2 if args[i] in ("-C", "-c") else 1
        return i < len(args) and args[i] in PASSIVE_GIT_SUBCOMMANDS
    if cmd == "gh":
        return len(args) >= 2 and args[1] in PASSIVE_GH_ACTIONS
    if cmd not in PASSIVE_SHELL_COMMANDS:
        return False
    if cmd == "sed" and any(a.startswith("-i") or a.startswith("--in-place") for a in args):
        return False
    if cmd == "find" and any(a in ("-exec", "-execdir", "-ok", "-okdir", "-delete", "-fprint") for a in args):
        return False
    if cmd == "sort" and any(a == "-o" or a.startswith("--output") for a in args):
        return False
    return True


def is_passive_shell_command(command: str) -> bool:
    """True si todos los segmentos del comando son de mera inspección (sin escrituras ni subshells)."""
    if not isinstance(command, str) or not command.strip():
        return False
    cleaned = _SAFE_REDIRECTS.sub(" ", command)
    if ">" in cleaned or "<<" in cleaned or "$(" in cleaned or "`" in cleaned:
        return False
    for segment in _SHELL_SEGMENT_SPLIT.split(cleaned):
        try:
            tokens = shlex.split(segment)
        except ValueError:
            return False
        while tokens and tokens[0] in SHELL_PREFIX_KEYWORDS:
            tokens = tokens[1:]
        if not tokens or tokens[0] in SHELL_CONTROL_SEGMENTS:
            continue
        if "=" in tokens[0] or not _is_passive_shell_tokens(tokens):
            return False
    return True


def normalize_claude_tool(name: str, tool_input: Any) -> Dict[str, Any]:
    """Traduce una invocación de Claude Code al formato de tool_call que usa el breaker."""
    args = tool_input if isinstance(tool_input, dict) else {}
    if name == "Bash":
        command = args.get("command", "")
        if is_passive_shell_command(command):
            compact = " ".join(command.split())[:80]
            return {"name": "Bash(read)", "args": {}, "sig": f"Bash(read):{compact}"}
        return {"name": "Bash", "args": {}, "sig": "Bash"}
    return {"name": name, "args": args, "sig": get_tool_signature(name, args)}


def _is_tool_result_only(content: Any) -> bool:
    return (
        isinstance(content, list)
        and len(content) > 0
        and all(isinstance(b, dict) and b.get("type") == "tool_result" for b in content)
    )


def read_recent_claude_records(transcript_path: Path) -> List[Dict[str, Any]]:
    """
    Normaliza el transcript de Claude Code a registros {tool_calls} / {type: USER_INPUT}.
    Agrupa por message.id (un mensaje del modelo = un paso), descarta los tool_use sin
    tool_result (la llamada en curso y sus paralelas) y omite registros meta y de subagentes.
    """
    if not transcript_path.is_file():
        return []
    try:
        raw = read_tail_json_lines(transcript_path, CLAUDE_TAIL_BYTES)
    except Exception:
        return []

    completed = set()
    for rec in raw:
        content = (rec.get("message") or {}).get("content")
        if isinstance(content, list):
            for b in content:
                if isinstance(b, dict) and b.get("type") == "tool_result" and b.get("tool_use_id"):
                    completed.add(b["tool_use_id"])

    normalized: List[Dict[str, Any]] = []
    steps_by_message: Dict[str, Dict[str, Any]] = {}
    for rec in raw:
        if rec.get("isSidechain") or rec.get("isMeta"):
            continue
        message = rec.get("message") or {}
        content = message.get("content")
        rec_type = rec.get("type")
        if rec_type == "user":
            if content and not _is_tool_result_only(content):
                normalized.append({"type": "USER_INPUT"})
                steps_by_message = {}
            continue
        if rec_type != "assistant" or not isinstance(content, list):
            continue
        calls = [
            normalize_claude_tool(b.get("name", ""), b.get("input"))
            for b in content
            if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("id") in completed
        ]
        if not calls:
            continue
        message_id = message.get("id")
        if message_id and message_id in steps_by_message:
            steps_by_message[message_id]["tool_calls"].extend(calls)
            continue
        step = {"tool_calls": calls}
        normalized.append(step)
        if message_id:
            steps_by_message[message_id] = step

    last_user_idx = -1
    for idx, rec in enumerate(normalized):
        if rec.get("type") == "USER_INPUT":
            last_user_idx = idx
    return normalized[last_user_idx + 1:]


def _count_lines_up_to(path: Path, limit: int) -> Optional[int]:
    """Cuenta líneas hasta superar `limit` (corte temprano). None si no es un archivo legible."""
    try:
        if not path.is_file():
            return None
        count = 0
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                count += chunk.count(b"\n")
                if count > limit:
                    return count
        return count
    except OSError:
        return None


def evaluate_claude_read_paging(tool_input: Any) -> Optional[dict]:
    """Deniega lecturas con ventana > 200 líneas o sin paginar sobre archivos > 150 líneas."""
    args = tool_input if isinstance(tool_input, dict) else {}
    file_path = str(args.get("file_path", ""))
    limit = args.get("limit")
    try:
        limit = int(limit) if limit is not None else None
    except (TypeError, ValueError):
        limit = None

    if limit is not None:
        if limit > READ_MAX_WINDOW:
            return {
                "decision": "deny",
                "reason": (
                    f"Lectura paginada obligatoria: ventana de {limit} líneas supera el máximo de "
                    f"{READ_MAX_WINDOW}. Reintentar con limit ≤ {READ_MAX_WINDOW} "
                    f"(≤ 50 en lectura quirúrgica tras localizar por búsqueda de contenido)."
                ),
            }
        return None

    path = Path(file_path)
    if not file_path or path.suffix.lower() in NON_TEXT_SUFFIXES:
        return None
    lines = _count_lines_up_to(path, READ_UNPAGED_MAX_LINES)
    if lines is not None and lines > READ_UNPAGED_MAX_LINES:
        return {
            "decision": "deny",
            "reason": (
                f"Lectura paginada obligatoria: '{path.name}' supera {READ_UNPAGED_MAX_LINES} líneas y se "
                f"pidió sin limit. Localizar primero por búsqueda de contenido y leer una ventana "
                f"quirúrgica con offset/limit (≤ 50 líneas; máximo {READ_MAX_WINDOW})."
            ),
        }
    return None


def evaluate_claude_pre_tool_use(payload: dict) -> dict:
    """Evalúa el payload PreToolUse de Claude Code y retorna la decisión canónica."""
    tool_name = payload.get("tool_name", "")
    tool_input = payload.get("tool_input") or {}

    if tool_name == "Read":
        paging = evaluate_claude_read_paging(tool_input)
        if paging:
            return paging

    candidate = normalize_claude_tool(tool_name, tool_input)
    # Paridad con el matcher de Antigravity: solo las lecturas pasivas pasan por el breaker,
    # así los ciclos editar -> probar no se confunden con ping-pong.
    if candidate["name"] not in PASSIVE_TOOLS:
        return {"decision": "allow"}

    transcript_path_str = payload.get("transcript_path")
    if not transcript_path_str:
        return {"decision": "allow"}
    recent_records = read_recent_claude_records(Path(transcript_path_str))
    return evaluate_loops(candidate["name"], candidate["sig"], recent_records)


def is_claude_payload(payload: dict) -> bool:
    return "hook_event_name" in payload or "tool_name" in payload


def to_claude_output(result: dict) -> Optional[dict]:
    """Solo se emite salida al denegar: un 'allow' explícito saltearía los permisos de Claude Code."""
    if result.get("decision") != "deny":
        return None
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": result.get("reason", ""),
        }
    }


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        sys.stdout.write("Uso: agent-circuit-breaker\n")
        sys.stdout.write("Lifecycle Hook PreToolUse para corte determinista de bucles pasivos.\n")
        return 0

    try:
        raw_input = sys.stdin.read()
        if not raw_input.strip():
            sys.stdout.write(json.dumps({"decision": "allow"}) + "\n")
            return 0
        payload = json.loads(raw_input)
    except Exception:
        sys.stdout.write(json.dumps({"decision": "allow"}) + "\n")
        return 0

    if isinstance(payload, dict) and is_claude_payload(payload):
        try:
            output = to_claude_output(evaluate_claude_pre_tool_use(payload))
        except Exception:
            output = None  # Fail-open: un error del hook no debe bloquear la sesión.
        if output:
            sys.stdout.write(json.dumps(output, ensure_ascii=False) + "\n")
        return 0

    result = evaluate_pre_tool_use(payload)
    sys.stdout.write(json.dumps(result, ensure_ascii=False) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
