{
  "permissions": {
    "allow": [
      "Read(~/.claude/skills/**)",
      "Read(/${DOTFILES_ROOT}/skills/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit -F .commit_msg:*)",
      "Bash(git push -u origin:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh project item-add:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh label list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh board:*)",
      "Bash(gh board-ready:*)",
      "Bash(agent-audit:*)",
      "Bash(agent-module:*)",
      "Bash(gh-pr-review:*)",
      "Bash(git-prune-gone:*)",
      "Bash(./build.sh check:*)",
      "Bash(./build.sh build:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${DOTFILES_ROOT}/skills/conversation-audit/bin/agent-circuit-breaker",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
