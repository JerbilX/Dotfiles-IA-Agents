{
  "circuit-breaker": {
    "PreToolUse": [
      {
        "matcher": "view_file|grep_search|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "agent-circuit-breaker",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "guards": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "agent-guard",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
